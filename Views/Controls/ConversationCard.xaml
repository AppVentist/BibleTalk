<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:BibleTalk.ViewModels" x:Class="BibleTalk.Views.Controls.ConversationCard" x:DataType="vm:ConversationItemViewModel">
 <Border Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 16" Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
  <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenCommand}" /></Border.GestureRecognizers>
  <Grid ColumnDefinitions="36,*,20" ColumnSpacing="10">
   <Label Text="{Binding Symbol}" FontSize="28" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" />
   <VerticalStackLayout Grid.Column="1" Spacing="5">
    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
    <Label Text="{Binding Details}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
    <Label Text="{Binding Category}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />
   </VerticalStackLayout>
   <Button Grid.Column="2" Text="›" Padding="0" FontSize="24" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" Command="{Binding OpenCommand}" SemanticProperties.Description="Gespräch öffnen" />
  </Grid>
 </Border>
</ContentView>
