<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BibleTalk.ViewModels"
             xmlns:models="clr-namespace:BibleTalk.Models"
             x:Class="BibleTalk.Views.Controls.BibleTextCard"
             x:DataType="vm:BibleStepViewModel"
             IsVisible="{Binding HasBibleSection}">

    <!-- Ausklappbare Bibeltext-Karte.
         Der Text kommt aus der gebündelten Übersetzung (Feld "passages"),
         ersatzweise aus "bibleText".

         Diese Datei ist die EINZIGE Stelle, an der die Karte definiert ist.
         Sie erbt ihren BindingContext vom Elternelement - dort muss ein
         BibleStepViewModel (oder eine Ableitung davon) liegen. -->
    <Border Padding="14"
            Stroke="Transparent"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceVariant}, Dark={StaticResource DarkSurfaceVariant}}"
            StrokeShape="RoundRectangle 12">

        <VerticalStackLayout Spacing="8">

            <!-- Kopfzeile klappt die Karte auf/zu -->
            <Grid ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleBibleTextCommand}"/>
                </Grid.GestureRecognizers>
                <Label Grid.Column="0"
                       Text="Bibeltext"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
                <Label Grid.Column="1"
                       Text="&#x25B8;"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsBibleTextExpanded}"
                                     Value="True">
                            <Setter Property="Rotation" Value="90"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <VerticalStackLayout Spacing="10"
                                 IsVisible="{Binding IsBibleTextExpanded}">

                <Label Text="Bibeltext wird geladen …"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       IsVisible="{Binding IsLoadingBibleText}"/>

                <!-- Notizfeld -->
                <Label Text="{Binding BibleText}"
                       FontSize="15"
                       FontAttributes="Italic"
                       LineHeight="1.4"
                       IsVisible="{Binding HasManualBibleText}"/>

                <!-- Aufgelöste Stellen, je Stelle ein Block -->
                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding BiblePassages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:BiblePassage">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"/>
                                <VerticalStackLayout Spacing="3"
                                                     BindableLayout.ItemsSource="{Binding Verses}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:BibleVerse">
                                            <Grid ColumnDefinitions="22,*" ColumnSpacing="4">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Number}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource LightTextTertiary}, Dark={StaticResource DarkTextTertiary}}"
                                                       VerticalOptions="Start"
                                                       Margin="0,3,0,0"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       FontSize="15"
                                                       LineHeight="1.4"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Quellenangabe der Übersetzung -->
                <Label Text="{Binding TranslationName}"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextTertiary}, Dark={StaticResource DarkTextTertiary}}"
                       IsVisible="{Binding HasResolvedPassages}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
