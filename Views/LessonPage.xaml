<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BibleTalk.ViewModels"
             xmlns:controls="clr-namespace:BibleTalk.Views.Controls"
             x:Class="BibleTalk.Views.LessonPage"
             x:DataType="vm:LessonViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Jüngerschaft: durchgehender Lesetext statt Fokus-Modus.
         Kein Karussell - der Nutzer schreibt mit und blättert zurück. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Kopfzeile -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              Padding="16,14,16,10"
              VerticalOptions="Center">

            <Label Grid.Column="0"
                   Text="&#x2715;"
                   FontSize="20"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="{Binding NumberLabel}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   VerticalTextAlignment="Center"/>

            <Image Source="img_adventist_logo.png"
                   Grid.Column="2"
                   VerticalOptions="Center"
                   HeightRequest="25"
                   WidthRequest="25"/>
        </Grid>

        <!-- Hinweis, falls die Einheit noch keine Abschnitte hat -->
        <Label Grid.Row="1"
               Text="Die Inhalte werden demnächst veröffentlicht."
               FontSize="15"
               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
               Padding="24"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               IsVisible="{Binding IsEmpty}"/>

        <ScrollView Grid.Row="1" IsVisible="{Binding HasSections}">
            <VerticalStackLayout Padding="24,4,24,24" Spacing="0">

                <Label Text="{Binding Title}"
                       FontSize="24"
                       FontAttributes="Bold"
                       LineHeight="1.25"/>

                <!-- Merkvers der Einheit -->
                <Border IsVisible="{Binding HasMemoryVerse}"
                        Margin="0,16,0,0"
                        Padding="14"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceVariant}, Dark={StaticResource DarkSurfaceVariant}}"
                        StrokeShape="RoundRectangle 12">
                    <Label Text="{Binding MemoryVerse}"
                           FontSize="15"
                           FontAttributes="Italic"
                           LineHeight="1.4"/>
                </Border>

                <!-- Abschnitte der Einheit -->
                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LessonSectionViewModel">
                            <VerticalStackLayout Spacing="0" Margin="0,28,0,0">

                                <Label Text="{Binding Heading}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"/>

                                <!-- Fließtext: je Absatz ein Label -->
                                <VerticalStackLayout Spacing="10"
                                                     Margin="0,10,0,0"
                                                     IsVisible="{Binding HasParagraphs}"
                                                     BindableLayout.ItemsSource="{Binding Paragraphs}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}"
                                                   FontSize="16"
                                                   LineHeight="1.45"/>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Dieselbe Karte wie auf der QuestionsPage -->
                                <controls:BibleTextCard Margin="0,16,0,0"/>

                                <!-- Notizfeld. Mode=TwoWay ist zwingend -
                                     ohne passiert stillschweigend nichts. -->
                                <VerticalStackLayout Spacing="6"
                                                     Margin="0,16,0,0"
                                                     IsVisible="{Binding ShowNote}">
                                    <Label Text="{Binding NotePrompt}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
                                    <Border Padding="4,0"
                                            Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10">
                                        <Editor Text="{Binding Note, Mode=TwoWay}"
                                                Placeholder="Hier schreiben …"
                                                AutoSize="TextChanges"
                                                MinimumHeightRequest="90"
                                                FontSize="15"
                                                BackgroundColor="Transparent"/>
                                    </Border>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Deine Notizen werden automatisch lokal auf diesem Gerät gespeichert."
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextTertiary}, Dark={StaticResource DarkTextTertiary}}"
                       Margin="0,24,0,0"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Abschluss -->
        <Grid Grid.Row="2"
              Padding="24,8,24,16"
              IsVisible="{Binding HasSections}">
            <Button Text="Fertig"
                    FontSize="16"
                    HeightRequest="48"
                    CornerRadius="24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkButton}}"
                    TextColor="White"
                    Command="{Binding CloseCommand}"
                    Shadow="Gray 4 4"/>
        </Grid>
    </Grid>
</ContentPage>
