<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BibleTalk.ViewModels"
             x:Class="BibleTalk.Views.ArchivePage"
             x:DataType="vm:ArchiveViewModel"
             Title="Archiv der Standardausgabe">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Label Text="Archiv der Standardausgabe" FontSize="24" FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" />
        <SearchBar Grid.Row="1" Placeholder="Hefttitel oder Zeitraum suchen"
                   Text="{Binding SearchText}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyMessage}" Margin="0,8"
                       HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SeriesItemViewModel">
                    <Border Padding="12" Margin="0,0,0,10" StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="48,*,44" ColumnSpacing="12">
                            <Image Source="{Binding CoverImage}" HeightRequest="64" Aspect="AspectFit" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Subtitle}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="›" Padding="0" FontSize="24"
                                    BackgroundColor="Transparent" Command="{Binding OpenCommand}"
                                    TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                                    SemanticProperties.Description="{Binding Title, StringFormat='Heft öffnen: {0}'}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
