<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#2E5797</Color>
    <Color x:Key="PrimaryDark">#8FB0E3</Color>
    <Color x:Key="PrimaryDarkText">#0C1D2D</Color>
    <Color x:Key="Secondary">#E8EEF7</Color>
    <Color x:Key="SecondaryDarkText">#A3ADBF</Color>
    <Color x:Key="Tertiary">#1B3A66</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="LogoBlue">#2E5797</Color>
    <Color x:Key="Yellow">Yellow</Color>
    <Color x:Key="Orange">Orange</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- AppVentist-Markenfarben.
         WICHTIG: muss UNTER den Grundfarben stehen - StaticResource loest
         innerhalb einer ResourceDictionary von oben nach unten auf, ein
         Verweis auf White/Gray100 weiter oben wirft beim App-Start. -->
    <Color x:Key="BrandLight">#2E5797</Color>
    <Color x:Key="BrandDark">#1B3A66</Color>
    <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource BrandLight}"/>
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDark}"/>
    <SolidColorBrush x:Key="OnBrandLightBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="OnBrandDarkBrush" Color="#E6EAF2"/>

    <!-- ============================================================
         BibleTalk-Farbpalette (Light / Dark)
         Abgeleitet vom Logo-Blau #2E5797. "System" braucht keine
         eigene Palette - die App nimmt dann Light oder Dark, je nach
         Geraete-Einstellung.
         In Views immer paarweise verwenden:
         {AppThemeBinding Light={StaticResource LightX}, Dark={StaticResource DarkX}}
         ============================================================ -->

    <!-- Light -->
    <Color x:Key="LightBackground">#F8F7F4</Color>      <!-- Seitenhintergrund -->
    <Color x:Key="LightSurface">#FFFFFF</Color>         <!-- Karten, Navigationsleiste -->
    <Color x:Key="LightSurfaceVariant">#E8EEF7</Color>  <!-- Bibeltext-Karten, Fortschrittsbalken-Spur -->
    <Color x:Key="LightOutline">#D5DCE8</Color>         <!-- Rahmen, Trennlinien -->
    <Color x:Key="LightTextPrimary">#1A2233</Color>
    <Color x:Key="LightTextSecondary">#5A6478</Color>
    <Color x:Key="LightTextTertiary">#646D81</Color>    <!-- Hinweise, Quellenangaben -->
    <Color x:Key="LightPrimary">#2E5797</Color>         <!-- Logo-Blau: Buttons, Links, Akzente -->
    <Color x:Key="LightPrimaryPressed">#244677</Color>
    <Color x:Key="LightOnPrimary">#FFFFFF</Color>
    <Color x:Key="LightBrandCard">#2E5797</Color>
    <Color x:Key="LightAccent">#8F6A1B</Color>          <!-- warmes Gold, sparsam einsetzen -->
    <Color x:Key="LightError">#B3261E</Color>
    <Color x:Key="LightTabBar">#FFFFFF</Color>
    <Color x:Key="LightTabSelected">#2E5797</Color>
    <Color x:Key="LightTabUnselected">#5A6478</Color>

    <!-- Dark -->
    <Color x:Key="DarkBackground">#0C1D2D</Color>
    <Color x:Key="DarkSurface">#1B3044</Color>
    <Color x:Key="DarkSurfaceVariant">#242D3F</Color>
    <Color x:Key="DarkOutline">#33405A</Color>
    <Color x:Key="DarkTextPrimary">#E6EAF2</Color>
    <Color x:Key="DarkTextSecondary">#A3ADBF</Color>
    <Color x:Key="DarkTextTertiary">#8C98AE</Color>
    <Color x:Key="DarkPrimary">#8FB0E3</Color>          <!-- helles Blau fuer Text/Icons auf dunklem Grund -->
    <Color x:Key="DarkButton">#3D68AD</Color>           <!-- Button-Flaeche, weisse Schrift -->
    <Color x:Key="DarkOnPrimary">#FFFFFF</Color>
    <Color x:Key="DarkBrandCard">#1B3A66</Color>
    <Color x:Key="DarkAccent">#E0B85C</Color>
    <Color x:Key="DarkError">#F2B8B5</Color>
    <Color x:Key="DarkTabBar">#1B3044</Color>
    <Color x:Key="DarkTabSelected">#8FB0E3</Color>
    <Color x:Key="DarkTabUnselected">#A3ADBF</Color>

    <SolidColorBrush x:Key="LightSurfaceBrush" Color="{StaticResource LightSurface}"/>
    <SolidColorBrush x:Key="LightSurfaceVariantBrush" Color="{StaticResource LightSurfaceVariant}"/>
    <SolidColorBrush x:Key="LightOutlineBrush" Color="{StaticResource LightOutline}"/>
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurface}"/>
    <SolidColorBrush x:Key="DarkSurfaceVariantBrush" Color="{StaticResource DarkSurfaceVariant}"/>
    <SolidColorBrush x:Key="DarkOutlineBrush" Color="{StaticResource DarkOutline}"/>
</ResourceDictionary>
